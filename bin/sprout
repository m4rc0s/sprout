        else:
            print("Herdr Agent:       No active agent or pane currently mapped to this worktree in Herdr.")

    if handoff_file.exists():
        mtime = datetime.fromtimestamp(handoff_file.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S")
        print(f"Last Handoff:      {mtime} ({handoff_file})")
    else:
        print("Last Handoff:      None (session has not been recycled yet)")
    print("")

elif subcmd == "recycle":
    agent_info = find_agent_for_worktree(worktree_root, pane_override, agent_override)
    pane_id = None
    agent_kind = None
    agent_name = None
    is_respawn = False

    if agent_info:
