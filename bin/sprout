                try:
                    subprocess.run(["herdr", "workspace", "focus", ws_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception:
                    pass
            print(f"✓ Found existing Herdr pane {pane_id} for worktree.")
        else:
            print(f"✓ Creating fresh Herdr workspace for {worktree_root.name}...")
            pane_id = auto_spawn_workspace(worktree_root)
